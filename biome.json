{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!repos",
      "!**/dist",
      "!prototype",
      "!packages/viewer/src/styles/widgets.css"
    ]
  },
  "plugins": ["./lint/no-react-effect.grit"],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": "off",
      "a11y": "off",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noShadowRestrictedNames": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "effect": "Import the module directly (effect/Effect, effect/Schema, ...). The barrel defeats tree-shaking and the Effect language service flags it as importFromBarrel."
            }
          }
        }
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["vitest.config.ts", "vitest.eval.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/contract/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "effect": "Import the module directly (effect/Effect, effect/Schema, ...). The barrel defeats tree-shaking and the Effect language service flags it as importFromBarrel.",
                  "bun": "contract is pure and runs in the browser viewer; keep Bun, Node, and filesystem access in the cli.",
                  "effect/FileSystem": "contract is pure and runs in the browser viewer; keep Bun, Node, and filesystem access in the cli.",
                  "effect/Path": "contract is pure and runs in the browser viewer; keep Bun, Node, and filesystem access in the cli."
                },
                "patterns": [
                  {
                    "group": ["bun:*", "@effect/platform-*"],
                    "message": "contract is pure and runs in the browser viewer; keep Bun, Node, and filesystem access in the cli."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/viewer/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["useEffect", "useLayoutEffect", "useInsertionEffect"],
                    "message": "No effects. See lint/no-react-effect.grit for the replacements."
                  }
                },
                "patterns": [
                  {
                    "group": ["effect", "effect/*", "@effect/*", "bun", "bun:*"],
                    "message": "the viewer runs in the browser; Effect, Bun, and Node stay in the cli and contract."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/viewer/src/styles/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
