{
  "name": "explain-this",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.8",
      "@effect/language-service": "0.87.2",
      "@effect/platform-bun": "4.0.1",
      "@effect/vitest": "4.0.1",
      "@types/bun": "1.3.14",
      "@types/mdast": "4.0.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "beautiful-mermaid": "1.1.3",
      "effect": "4.0.1",
      "github-slugger": "2.0.0",
      "mdast-util-from-markdown": "2.1.0",
      "mdast-util-gfm": "3.1.0",
      "mdast-util-mdx-jsx": "3.2.0",
      "micromark-extension-gfm": "3.0.0",
      "micromark-extension-mdx-jsx": "3.0.2",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "shiki": "4.5.0",
      "typescript": "7.0.2",
      "vite": "8.3.4",
      "vitest": "5.0.3"
    }
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.1"
  },
  "scripts": {
    "prepare": "lefthook install",
    "explain": "bun packages/cli/src/main.ts",
    "typecheck": "bun --bun run tsc --build --noEmit tsconfig.json packages/*/tsconfig.json",
    "fmt": "biome check --write",
    "lint": "biome check",
    "test": "bun --bun run vitest run",
    "eval": "bun --bun run vitest run --config vitest.eval.config.ts",
    "vendor:effect": "bun scripts/vendor-effect.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/language-service": "catalog:",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "lefthook": "2.1.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
